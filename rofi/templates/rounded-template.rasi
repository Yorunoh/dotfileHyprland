@theme "themes/rounded-gray-dark.rasi"
* {
    font:   "JetBriansMono Nerd Font Medium 10";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    4px;
    border-radius: 10px;
}

window {
    location:       center;
    anchor:         center;
    width:          950px;
    background-color:   @bg0;
    fullscreen: false;
    border: 1px;
    border-color:  @bg3;
}

mainbox {
    orientation: horizontal;
    children: ["imagebox", "listview"];
}

imagebox {
    children: ["inputbar", "dummy", "mode-switcher"];
    background-image: url("/home/Yoru/Downloads/Wallpapers/wallpapers/animegirls/violet-evergarden.jpg", height);
    orientation: vertical;
    border-radius: 0px;
}


dummy {
    background-color:            transparent;
}

mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @bg3;
}

button {
    padding:                     15px;
    margin:                      10px;
    background-color:            @bg0;
    text-color:                  @fg2;
    cursor:                      pointer;
}
button selected {
    background-color:            @bg3;
    text-color:                  @fg1;
}


inputbar {
    background-color:   @bg1;
    border-color:       @bg3;
    border: 1px;
    margin: 20px;

    padding:    15px 15px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg2;
}

entry {
    placeholder:        "Search";
    border-radius: 0px;
    placeholder-color:  @fg3;
}

message {
    margin:             12px 0 0;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     20px;
    lines:      8;
    columns:    1;


    fixed-height: true;
}

element {
    padding: 15px 15px;
    cursor: pointer;
}

element normal active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

element selected normal, element selected active {
    background-color:   @bg3;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
